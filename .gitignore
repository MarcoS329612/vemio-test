# Data — never committed (client data + size). See DR-0002.
# Raw is immutable input; processed is reproducible from raw by committed code.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated figures are regenerated by the stage scripts.
# Generated markdown reports ARE committed: they are the readable record of results.
# Figures ARE committed: the stage reports embed them, and a reviewer reading a
# report on GitHub should see the plot, not a broken image.

# Python. Note: uv.lock IS committed — it is what makes the environment
# reproducible rather than merely re-installable (DR-0004).
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Notebooks are not the working medium here (DR-0003); this catches strays.
*.ipynb
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
~$*
*.swp
